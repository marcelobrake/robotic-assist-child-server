# Robotic Assist Child Server — example environment
# Copy to .env and adjust as needed.

SERVICE_NAME=robotic-assist-child-server
SERVICE_VERSION=0.1.0
DEPLOYMENT_ENVIRONMENT=local
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000

# For local (non-Docker) workspace runs the prompts repo is a sibling dir.
# Inside Docker it is mounted read-only at /app/prompts.
PROMPTS_REPOSITORY_PATH=../robotic-assist-child-prompts

# Local development auth bypass. Never enable in production-like environments.
# When true, /v1/interactions/text works without a token and uses user_id=dev_user.
DEV_AUTH_DISABLED=true

# Authentication. Override JWT_SECRET with a strong value outside local dev.
JWT_SECRET=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Relational database for users. Falls back to a local SQLite file when unset.
# DATABASE_URL takes precedence over POSTGRES_DSN.
# DATABASE_URL=sqlite+aiosqlite:///./rac_dev.db
POSTGRES_DSN=postgresql+psycopg://rac:rac@postgres:5432/rac

# MongoDB for per-user memory. When unset, an in-memory repository is used.
MONGODB_URI=mongodb://mongodb:27017/rac
MONGODB_DATABASE=rac

CONVERSATION_PROVIDER=fake
CONVERSATION_TEMPERATURE=0.4
CONVERSATION_MAX_TOKENS=700
CONVERSATION_TIMEOUT_SECONDS=30

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openai/gpt-5.4-nano
OPENROUTER_CHAT_MODEL_FALLBACK=openai/gpt-5.4-mini
OPENROUTER_HTTP_REFERER=http://localhost:8080
OPENROUTER_APP_TITLE=Robotic Assist Child
OPENROUTER_FALLBACK_TO_FAKE=true
OPENROUTER_MAX_RETRIES=2

IMAGE_PROVIDER=fake
IMAGE_GENERATION_ENABLED=false
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image-preview
IMAGE_STORAGE_PATH=/app/data/images
PUBLIC_IMAGE_BASE_URL=http://localhost:8080/v1/images
IMAGE_OUTPUT_FORMAT=png
IMAGE_TIMEOUT_SECONDS=60
IMAGE_MAX_RETRIES=1
IMAGE_FALLBACK_TO_FAKE=true
IMAGE_DEFAULT_ASPECT_RATIO=1:1
IMAGE_DEFAULT_SIZE=800x800

# Text-to-speech (TTS). Disabled by default; the fake provider needs no key.
# Set TTS_PROVIDER=elevenlabs and TTS_ENABLED=true to synthesize real audio.
# No input audio is stored; the API key/headers are never logged.
TTS_PROVIDER=fake
TTS_ENABLED=false
TTS_OUTPUT_FORMAT=mp3_44100_128
TTS_STORAGE_PATH=/app/data/audio
PUBLIC_AUDIO_BASE_URL=http://localhost:8080/v1/audio
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_TTS_TIMEOUT_SECONDS=30
ELEVENLABS_TTS_MAX_RETRIES=2
# Speaking rate sent as voice_settings.speed (clamped to 0.7-1.2).
# 1.0 is the natural pace; raise it to make Cubinho speak faster.
ELEVENLABS_TTS_SPEED=1.1

# Speech-to-text (STT) for POST /v1/interactions/audio.
# STT_PROVIDER selects the real adapter; when STT_ENABLED=false the fake
# provider is used so the endpoint works without keys or external calls.
# Default real provider is ElevenLabs; set STT_PROVIDER=openai to use the
# cheaper OpenAI batch model instead. Input audio is never stored and the
# API key/headers are never logged.
STT_PROVIDER=elevenlabs
STT_ENABLED=false
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_STT_REALTIME_MODEL=scribe_v2_realtime
ELEVENLABS_STT_TIMEOUT_SECONDS=30
OPENAI_API_KEY=
OPENAI_STT_BASE_URL=https://api.openai.com/v1
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_TIMEOUT_SECONDS=30

# Audio upload + listener mode controls.
MAX_AUDIO_UPLOAD_MB=10
AUDIO_INPUT_RETENTION=none
STORE_IGNORED_INTERACTIONS=false
LISTENER_MODE_REQUIRE_ADDRESSING=true
LISTENER_MODE_ALLOWED_TRIGGERS=Cubinho,oi,olá,ei,conta,desenha,explica,me ajuda,brinca

REDIS_URL=redis://redis:6379/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
